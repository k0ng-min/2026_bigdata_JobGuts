# Copy this file to .env and fill in the three values. .env is excluded from
# version control by .gitignore; never commit a real key.
#
# The GLM provider is only constructed when a command is run with
# --provider glm. The default run and every test use --provider fake and make
# no network call, so this file is not needed for them.
#
# None of the three has a default. A hardcoded address or model name would send
# the request somewhere the team did not choose, so a missing value stops the
# run with a message naming the variable.

# The API key. Keep it out of the shell history and out of commits.
GLM_API_KEY=

# The API root, NOT a full endpoint. The code appends /chat/completions itself.
# For the Z.ai GLM Coding Plan:
#   GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_BASE_URL=

# The model name. For the Z.ai GLM Coding Plan, one of:
#   GLM_MODEL=GLM-5.3          (stronger)
#   GLM_MODEL=GLM-5.3-Flash    (faster and cheaper; start here for samples)
GLM_MODEL=

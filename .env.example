# Copy this file to .env and fill in the value. .env is excluded from version
# control by .gitignore; never commit a real key.
#
# The GLM provider is only constructed when the agent is run with
# --provider glm. The default run and every test use --provider fake and make
# no network call, so this file is not needed for them.

# Required for --provider glm. Without it the run stops with an explicit message.
GLM_API_KEY=

# Optional. Defaults are used when these are left empty.
GLM_BASE_URL=
GLM_MODEL=
